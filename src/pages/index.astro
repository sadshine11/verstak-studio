---
import Base from '../layouts/Base.astro';
import ProductionSheet from '../components/ProductionSheet.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceList from '../components/ServiceList.astro';
import WorkIndex from '../components/WorkIndex.astro';
import Estimator from '../components/Estimator.astro';
import BriefForm from '../components/BriefForm.astro';
import { works, process, facts, testimonials, studio } from '../data/studio';
import { u } from '../lib/url';

const topWorks = works.slice(0, 5);
---

<Base
  title="ВЕРСТАК — студия проектирования и разработки сайтов"
  description="Веб-студия полного цикла: исследование, структура, дизайн-система, разработка и поддержка. Санкт-Петербург, работаем по России с 2017 года."
  bare
>
  <!-- ─────────────────────────── Открытие ─────────────────────────── -->
  <section class="open">
    <div class="wrap grid open__grid">
      <div class="open__main">
        <p class="label open__eyebrow">
          {studio.tagline} · {studio.city} · с {studio.since}
        </p>
        <h1 class="open__h">
          Делаем сайты, которые <span class="em">не приходится переделывать</span>
        </h1>
        <p class="lede open__lede">
          Разбираемся в бизнесе, проектируем структуру, пишем тексты — и только потом рисуем.
          Работаем с производством, медициной, девелопментом и сервисами: там, где решение
          принимают долго и сравнивают вас с пятью другими.
        </p>
        <div class="open__act">
          <a class="btn" href="#estimate">
            Рассчитать смету
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a class="arrow-link" href="#works">Посмотреть работы <span aria-hidden="true">→</span></a>
        </div>
        <dl class="open__meta">
          <div class="open__metaItem">
            <dt class="label">Проектов</dt>
            <dd class="num">68</dd>
          </div>
          <div class="open__metaItem">
            <dt class="label">Средний срок</dt>
            <dd class="num">8 недель</dd>
          </div>
          <div class="open__metaItem">
            <dt class="label">Гарантия</dt>
            <dd class="num">6 месяцев</dd>
          </div>
        </dl>
      </div>

      <div class="open__side">
        <ProductionSheet />
      </div>
    </div>
  </section>

  <!-- ─────────────────────────── 01 Услуги ─────────────────────────── -->
  <section class="band band--paper" id="services">
    <div class="wrap">
      <div class="grid">
        <SectionHead
          n="01 / Услуги"
          title="Пять видов работ и честная цена входа"
          note="Разверните строку — внутри состав работ, для кого это и на чём обычно собираем."
        />
      </div>
      <ServiceList />
      <p class="services__foot">
        Не нашли свой случай? Делали аудиты, спасали чужие проекты и переносили сайты с
        конструкторов. <a href={u('/contact')}>Опишите задачу</a> — скажем, беремся или нет,
        и почему.
      </p>
    </div>
  </section>

  <!-- ─────────────────────────── 02 Работы ─────────────────────────── -->
  <section class="band" id="works">
    <div class="wrap">
      <div class="grid">
        <SectionHead
          n="02 / Работы"
          title="Работы, за которые отвечаем именем"
          note="Пять из девяти проектов в портфолио. Наведите на строку — справа появится схема главного экрана."
        />
      </div>
      <WorkIndex items={topWorks} />
      <div class="works__more">
        <a class="arrow-link" href={u('/works')}>Все работы и фильтр по типу <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ─────────────────────────── 03 Процесс ─────────────────────────── -->
  <section class="band band--ink" id="process">
    <div class="wrap">
      <div class="grid">
        <SectionHead
          n="03 / Процесс"
          title="Пять этапов, у каждого — результат на руках"
          note="Мы не показываем «прогресс» словами: в конце каждого этапа вы получаете документ или сборку, которую можно открыть."
        />
      </div>

      <ol class="proc">
        {
          process.map((step, i) => (
            <li class="proc__step" data-reveal style={`--d:${i * 70}ms`}>
              <span class="proc__dot" aria-hidden="true" />
              <p class="proc__n mono">{step.n}</p>
              <h3 class="proc__title">{step.title}</h3>
              <p class="proc__term mono">{step.term}</p>
              <p class="proc__body">{step.body}</p>
              <p class="proc__out">
                <span class="label">На выходе</span>
                {step.output}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ─────────────────────────── 04 Смета ─────────────────────────── -->
  <section class="band" id="estimate">
    <div class="wrap">
      <div class="grid">
        <SectionHead
          n="04 / Смета"
          title="Считайте сами — по тем же нормативам, что и мы"
          note="Это не «стоимость сайта от 99 000 ₽». Ставка 3 400 ₽/час, состав разделов и объём — как в рабочей смете студии."
        />
      </div>
      <Estimator />
    </div>
  </section>

  <!-- ─────────────────────────── 05 Доказательства ──────────────────── -->
  <section class="band band--paper" id="proof">
    <div class="wrap">
      <div class="grid">
        <SectionHead n="05 / Проверка" title="Чем это подтверждается" />
      </div>

      <dl class="facts">
        {
          facts.map((f, i) => (
            <div class="facts__item" data-reveal style={`--d:${i * 60}ms`}>
              <dt class="facts__v num">
                {f.value}
                <span class="facts__u">{f.unit}</span>
              </dt>
              <dd class="facts__n">{f.note}</dd>
            </div>
          ))
        }
      </dl>

      <div class="quotes">
        {
          testimonials.map((t) => (
            <figure class="quote">
              <blockquote class="quote__text em">«{t.text}»</blockquote>
              <figcaption class="quote__by">
                <span class="quote__name">{t.name}</span>
                <span class="mono quote__post">{t.post}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ─────────────────────────── 06 Контакт ─────────────────────────── -->
  <section class="band" id="contact">
    <div class="wrap">
      <div class="grid">
        <SectionHead
          n="06 / Контакт"
          title="Расскажите про задачу"
          note="Чем конкретнее опишете, тем полезнее будет первый ответ. Бриф занимает три минуты."
        />
      </div>

      <div class="cta grid">
        <div class="cta__side">
          <ol class="steps">
            <li class="steps__item">
              <span class="steps__n mono">1</span>
              <span>
                <strong>Ответим за 3 часа</strong> в рабочее время — письмом с вопросами по задаче.
              </span>
            </li>
            <li class="steps__item">
              <span class="steps__n mono">2</span>
              <span>
                <strong>Созвон на 40 минут</strong>: кто ваш клиент, что мешает сейчас, какие сроки.
              </span>
            </li>
            <li class="steps__item">
              <span class="steps__n mono">3</span>
              <span>
                <strong>Вилка и план по неделям</strong> — до любых договорённостей и без предоплаты.
              </span>
            </li>
          </ol>

          <div class="cta__direct">
            <p class="label">Или напрямую</p>
            <a class="cta__link" href={`mailto:${studio.email}`}>{studio.email}</a>
            <a class="cta__link" href={`tel:${studio.phoneHref}`}>{studio.phone}</a>
            <a class="cta__link" href={studio.telegramHref} rel="noopener">Telegram {studio.telegram}</a>
            <p class="mono cta__hours">{studio.hours}</p>
          </div>
        </div>

        <div class="cta__form">
          <BriefForm compact />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* --- Открытие --- */
  .open { padding-block: clamp(2.25rem, 1rem + 4vw, 4.5rem) clamp(2.5rem, 1rem + 5vw, 5rem); }
  .open__grid { align-items: start; row-gap: 2.5rem; }
  .open__main { grid-column: span 7; display: grid; gap: 1.5rem; align-content: start; }
  .open__side { grid-column: 8 / span 5; }

  .open__eyebrow {
    display: inline-block;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line-2);
    width: 100%;
  }
  .open__h { max-width: 17ch; }
  .open__h .em { color: var(--ink); }
  .open__lede { max-width: 52ch; }

  .open__act { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }

  .open__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.5rem;
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-2);
  }
  .open__metaItem { display: grid; gap: 0.3rem; }
  .open__metaItem dd { margin: 0; font-size: 1.0625rem; font-weight: 500; }

  @media (max-width: 1100px) {
    .open__main { grid-column: span 12; }
    .open__side { grid-column: span 12; max-width: 30rem; }
  }
  @media (max-width: 900px) {
    .open__main,
    .open__side { grid-column: 1 / -1; }
    .open__side { max-width: none; }
  }

  /* --- Услуги --- */
  .services__foot {
    margin-top: 1.5rem;
    font-size: 0.9375rem;
    color: var(--ink-3);
    max-width: 60ch;
    line-height: 1.5;
  }
  .services__foot a { color: var(--ink); }

  /* --- Работы --- */
  .works__more { margin-top: 1.75rem; }

  /* --- Процесс --- */
  .proc {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--line-2);
  }
  .proc__step {
    position: relative;
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.5rem 1.25rem 0 0;
    border-right: 1px solid var(--line);
  }
  .proc__step:last-child { border-right: 0; }
  .proc__step:not(:first-child) { padding-left: 1.25rem; }
  .proc__dot {
    position: absolute;
    top: -4px;
    left: 0;
    width: 7px;
    height: 7px;
    background: var(--marker);
  }
  .proc__step:not(:first-child) .proc__dot { left: 1.25rem; }
  .proc__n { color: var(--ink-3); }
  .proc__title { font-size: var(--step-2); }
  .proc__term { color: var(--marker); }
  .proc__body { font-size: 0.9375rem; line-height: 1.5; color: var(--ink-2); }
  .proc__out {
    margin-top: 0.4rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--line);
    font-size: 0.8125rem;
    line-height: 1.45;
    display: grid;
    gap: 0.25rem;
  }

  @media (max-width: 1100px) {
    .proc { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .proc__step { padding: 1.5rem 1.25rem 1.5rem 0; border-bottom: 1px solid var(--line); }
    .proc__step:nth-child(2n) { border-right: 0; padding-left: 1.25rem; }
    .proc__step:nth-child(2n) .proc__dot { left: 1.25rem; }
    .proc__step:nth-child(odd) .proc__dot { left: 0; }
    .proc__step:last-child { border-bottom: 0; }
  }
  @media (max-width: 680px) {
    .proc { grid-template-columns: minmax(0, 1fr); }
    .proc__step,
    .proc__step:nth-child(2n) { border-right: 0; padding: 1.35rem 0 1.35rem 1.25rem; }
    .proc__step .proc__dot,
    .proc__step:nth-child(2n) .proc__dot { left: 0; top: 1.8rem; }
    .proc__step { border-left: 1px solid var(--line); border-bottom: 0; }
  }

  /* --- Проверка --- */
  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gutter);
    margin: 0 0 clamp(2rem, 1rem + 3vw, 3.5rem);
    padding-bottom: clamp(2rem, 1rem + 3vw, 3rem);
    border-bottom: 1px solid var(--line-2);
  }
  .facts__item { display: grid; gap: 0.5rem; align-content: start; }
  .facts__v {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3.25rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .facts__u {
    font-family: var(--font);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink-3);
  }
  .facts__n {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--ink-2);
    max-width: 26ch;
  }
  @media (max-width: 900px) {
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 1.75rem; }
  }

  .quotes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gutter);
  }
  .quote {
    margin: 0;
    display: grid;
    gap: 1rem;
    align-content: start;
    padding-left: 1.25rem;
    border-left: 2px solid var(--accent);
  }
  .quote__text {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink);
    margin: 0;
  }
  .quote__by { display: grid; gap: 0.2rem; }
  .quote__name { font-weight: 600; font-size: 0.9375rem; }
  .quote__post { color: var(--ink-3); }
  @media (max-width: 860px) {
    .quotes { grid-template-columns: minmax(0, 1fr); row-gap: 2rem; }
  }

  /* --- Контакт --- */
  .cta { row-gap: 2.5rem; align-items: start; }
  .cta__side { grid-column: span 4; display: grid; gap: 2rem; align-content: start; }
  .cta__form { grid-column: 6 / span 7; }

  .steps { display: grid; gap: 0.9rem; }
  .steps__item {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .steps__n {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid var(--line-strong);
    font-size: 0.6875rem;
  }
  .steps__item strong { color: var(--ink); font-weight: 600; }

  .cta__direct { display: grid; gap: 0.3rem; padding-top: 1.25rem; border-top: 1px solid var(--line-2); }
  .cta__link { width: fit-content; text-decoration: none; font-weight: 500; }
  .cta__link:hover { color: var(--accent); }
  .cta__hours { color: var(--ink-3); padding-top: 0.5rem; }

  @media (max-width: 1000px) {
    .cta__side { grid-column: 1 / -1; }
    .cta__form { grid-column: 1 / -1; }
  }
</style>
