---
import Base from '../../layouts/Base.astro';
import WorkIndex from '../../components/WorkIndex.astro';
import { works, studio } from '../../data/studio';
import { u } from '../../lib/url';

const years = works.map((w) => w.year);
const span = `${Math.min(...years)}–${Math.max(...years)}`;
---

<Base
  title="Работы"
  description="Девять проектов студии ВЕРСТАК: B2B-каталоги, сайты клиник, девелоперские проекты, магазины и личные кабинеты. С задачами, ограничениями и результатом."
>
  <section class="phead">
    <div class="wrap grid">
      <div class="phead__main">
        <p class="label phead__crumbs">
          <a href={u('/')}>Главная</a> <span aria-hidden="true">/</span> Работы
        </p>
        <h1>Девять проектов и то, что в каждом было сложного</h1>
        <p class="lede">
          Мы не показываем «более 500 успешных проектов». Здесь всё, что студия сделала
          с {Math.min(...years)} по {Math.max(...years)} год и может обсуждать открыто: что было
          на входе, где пришлось спорить с заказчиком и чем всё закончилось.
        </p>
      </div>

      <dl class="phead__spec">
        <div><dt class="label">Период</dt><dd class="num">{span}</dd></div>
        <div><dt class="label">Отраслей</dt><dd class="num">9</dd></div>
        <div><dt class="label">Средний срок</dt><dd class="num">8 недель</dd></div>
        <div><dt class="label">Разборов</dt><dd class="num">3</dd></div>
      </dl>
    </div>
  </section>

  <section class="band works">
    <div class="wrap">
      <WorkIndex items={works} filter />
    </div>
  </section>

  <section class="band band--ink">
    <div class="wrap next">
      <div class="next__text">
        <h2>Похожая задача?</h2>
        <p class="lede">
          Скажем честно, делали ли мы такое раньше. Если нет — скажем и это: половина
          интересных проектов начинается с «мы такого ещё не делали, но понимаем как».
        </p>
      </div>
      <div class="next__act">
        <a class="btn" href={u('/contact')}>
          Описать задачу
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="arrow-link" href={`mailto:${studio.email}`}>{studio.email} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .phead {
    padding-block: clamp(2rem, 1rem + 3vw, 3.5rem) clamp(2rem, 1rem + 3vw, 3rem);
    border-bottom: 1px solid var(--line-2);
  }
  .phead__main { grid-column: span 7; display: grid; gap: 1.1rem; align-content: start; }
  .phead__crumbs { display: flex; gap: 0.5rem; }
  .phead__crumbs a { text-decoration: none; }
  .phead__crumbs a:hover { color: var(--accent); }

  .phead__spec {
    grid-column: 9 / span 4;
    align-self: end;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding-left: var(--gutter);
    border-left: 1px solid var(--line-2);
  }
  .phead__spec div { display: grid; gap: 0.3rem; }
  .phead__spec dd { margin: 0; font-size: 1.0625rem; font-weight: 500; }

  .works { padding-top: clamp(2rem, 1rem + 3vw, 3rem); }

  .next {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }
  .next__text { display: grid; gap: 0.9rem; max-width: 46ch; }
  .next__act { display: grid; gap: 1rem; justify-items: start; }

  @media (max-width: 1000px) {
    .phead__main { grid-column: 1 / -1; }
    .phead__spec {
      grid-column: 1 / -1;
      padding-left: 0;
      border-left: 0;
      padding-top: 1.25rem;
      border-top: 1px solid var(--line-2);
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 620px) {
    .phead__spec { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
