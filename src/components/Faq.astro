---
import { faq } from '../data/studio';
---

<div class="faq">
  {
    faq.map((item, i) => (
      <details class="faq__item" open={i === 0}>
        <summary class="faq__q">
          <span>{item.q}</span>
          <span class="faq__mark" aria-hidden="true" />
        </summary>
        <div class="faq__a">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq { border-top: 1px solid var(--line-2); }
  .faq__item { border-bottom: 1px solid var(--line-2); }

  .faq__q {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.25rem;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 0.25rem;
    cursor: pointer;
    list-style: none;
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: -0.015em;
    transition: color var(--dur) var(--ease);
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:hover { color: var(--accent); }

  .faq__mark {
    position: relative;
    width: 12px;
    height: 12px;
    justify-self: end;
  }
  .faq__mark::before,
  .faq__mark::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.2s var(--ease);
  }
  .faq__mark::after { transform: rotate(90deg); }
  .faq__item[open] .faq__mark::after { transform: rotate(0deg); }

  .faq__a {
    padding: 0 3rem 1.4rem 0.25rem;
    max-width: 72ch;
    animation: faqIn 0.25s var(--ease);
  }
  .faq__a p { color: var(--ink-2); line-height: 1.6; font-size: 0.9375rem; }
  @keyframes faqIn {
    from { opacity: 0; transform: translateY(-5px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq__a { animation: none; }
  }
  @media (max-width: 560px) {
    .faq__a { padding-right: 0.25rem; }
  }
</style>
