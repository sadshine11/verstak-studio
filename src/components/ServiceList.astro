---
import { services } from '../data/studio';
---

<div class="svc">
  {
    services.map((s, i) => (
      <details class="svc__item" name="services" open={i === 0} id={`svc-${s.id}`}>
        <summary class="svc__sum">
          <span class="svc__n mono">{String(i + 1).padStart(2, '0')}</span>
          <span class="svc__ttl">
            <span class="svc__name">{s.title}</span>
            <span class="svc__sub">{s.summary}</span>
          </span>
          <span class="svc__price num">{s.price}</span>
          <span class="svc__term mono">{s.term}</span>
          <span class="svc__mark" aria-hidden="true" />
        </summary>

        <div class="svc__body">
          <div class="svc__col svc__col--wide">
            <h4 class="label">Что входит</h4>
            <ul class="svc__list">
              {s.includes.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </div>
          <div class="svc__col">
            <h4 class="label">Кому подходит</h4>
            <p class="svc__text">{s.forWhom}</p>
          </div>
          <div class="svc__col">
            <h4 class="label">Обычный стек</h4>
            <p class="svc__text mono svc__stack">{s.stack}</p>
          </div>
        </div>
      </details>
    ))
  }
</div>

<style>
  .svc { border-top: 1px solid var(--line-2); }
  .svc__item { border-bottom: 1px solid var(--line-2); }

  .svc__sum {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto auto 1.5rem;
    align-items: baseline;
    gap: 0 1.25rem;
    padding: 1.35rem 0.25rem;
    cursor: pointer;
    list-style: none;
    transition: background var(--dur) var(--ease), padding-left var(--dur) var(--ease);
  }
  .svc__sum::-webkit-details-marker { display: none; }
  .svc__sum:hover { background: color-mix(in srgb, var(--ink) 5%, transparent); }
  .svc__item[open] .svc__sum { background: color-mix(in srgb, var(--ink) 4%, transparent); }

  .svc__n { color: var(--ink-3); font-size: 0.6875rem; }
  .svc__ttl { display: grid; gap: 0.3rem; }
  .svc__name {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .svc__sub { font-size: 0.9375rem; color: var(--ink-2); line-height: 1.45; max-width: 46ch; }
  .svc__price { font-size: 0.9375rem; font-weight: 500; white-space: nowrap; }
  .svc__term { color: var(--ink-3); white-space: nowrap; }

  .svc__mark {
    position: relative;
    width: 14px;
    height: 14px;
    justify-self: end;
    align-self: center;
  }
  .svc__mark::before,
  .svc__mark::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.2s var(--ease);
  }
  .svc__mark::after { transform: rotate(90deg); }
  .svc__item[open] .svc__mark::after { transform: rotate(0deg); }

  .svc__body {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem var(--gutter);
    padding: 0.25rem 0.25rem 2rem 3.75rem;
    animation: svcIn 0.28s var(--ease);
  }
  @keyframes svcIn {
    from { opacity: 0; transform: translateY(-6px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .svc__body { animation: none; }
  }

  .svc__col { display: grid; gap: 0.6rem; align-content: start; }
  .svc__list { display: grid; gap: 0.5rem; }
  .svc__list li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .svc__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 1px;
    background: var(--accent);
  }
  .svc__text { font-size: 0.9375rem; line-height: 1.45; color: var(--ink-2); }
  .svc__stack { font-size: 0.8125rem; color: var(--ink-3); line-height: 1.5; }

  @media (max-width: 1000px) {
    .svc__sum {
      grid-template-columns: 2rem minmax(0, 1fr) 1.5rem;
      gap: 0.35rem 0.9rem;
    }
    .svc__price { grid-column: 2; font-size: 0.875rem; }
    .svc__term { grid-column: 2; font-size: 0.75rem; }
    .svc__mark { grid-row: 1; grid-column: 3; }
    .svc__body { grid-template-columns: minmax(0, 1fr); padding-left: 2.9rem; gap: 1.25rem; }
  }
  @media (max-width: 560px) {
    .svc__body { padding-left: 0.25rem; }
    .svc__sum { grid-template-columns: 1.6rem minmax(0, 1fr) 1.2rem; }
  }
</style>
